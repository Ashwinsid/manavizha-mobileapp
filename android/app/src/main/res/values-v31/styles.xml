<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash API: match branded gradient / teal — avoids white frame before Flutter -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
